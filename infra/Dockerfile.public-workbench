FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /app
COPY pyproject.toml README.md LICENSE NOTICE THIRD_PARTY_NOTICES.md ./
COPY licenses ./licenses
COPY tradingagents ./tradingagents
COPY cli ./cli
COPY worker-source.tar.gz ./worker-source.tar.gz
RUN pip install --no-cache-dir ".[public-workbench]" \
    && useradd --create-home appuser

USER appuser
EXPOSE 8080
ENTRYPOINT ["python", "-m", "uvicorn", "tradingagents.workbench.public_runtime:create_runtime_app", "--factory", "--host", "0.0.0.0", "--port", "8080", "--no-access-log", "--no-proxy-headers"]