FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /app
COPY pyproject.toml README.md LICENSE NOTICE THIRD_PARTY_NOTICES.md ./
COPY licenses ./licenses
COPY tradingagents ./tradingagents
COPY cli ./cli
RUN pip install --no-cache-dir ".[workbench]" \
    && useradd --create-home appuser \
    && install -d -m 0755 -o appuser /home/appuser/.tradingagents

USER appuser
ENTRYPOINT ["python", "-m", "tradingagents.workbench.worker"]